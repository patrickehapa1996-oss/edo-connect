{
  "name": "edo-connect",
  "version": "1.0.0",
  "private": true,
  "description": "EdoConnect - Connecting communities through technology",
  "workspaces": [
    "edoconnect-backend",
    "edoconnect-web",
    "edoconnect-mobile"
  ],
  "scripts": {
    "prepare": "husky",
    "backend": "npm run start:dev --workspace=edoconnect-backend",
    "backend:build": "npm run build --workspace=edoconnect-backend",
    "backend:lint": "npm run lint --workspace=edoconnect-backend",
    "web": "npm run dev --workspace=edoconnect-web",
    "web:build": "npm run build --workspace=edoconnect-web",
    "web:lint": "npm run lint --workspace=edoconnect-web",
    "mobile:start": "npm run start --workspace=edoconnect-mobile",
    "mobile:ios": "npm run ios --workspace=edoconnect-mobile",
    "mobile:android": "npm run android --workspace=edoconnect-mobile",
    "mobile:lint": "npm run lint --workspace=edoconnect-mobile",
    "install:all": "npm install && npm install --workspace=edoconnect-backend && npm install --workspace=edoconnect-web && npm install --workspace=edoconnect-mobile",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "lint:staged": "lint-staged",
    "test": "npm run test --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "prettier --check .",
    "type-check": "npm run type-check --workspaces --if-present",
    "validate": "npm run lint && npm run type-check && npm run test",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^18.4.4",
    "husky": "^9.0.6",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.2"
  },
  "lint-staged": {
    "edoconnect-backend/**/*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "edoconnect-web/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "edoconnect-mobile/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "EdoConnect Team",
  "license": "MIT"
}
